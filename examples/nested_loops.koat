(GOAL COMPLEXITY)
(STARTTERM (FUNCTIONSYMBOLS koat_init))
(VAR LI0 LI1 LI2 LI3 SI0 SI1)
(RULES
  koat_init(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_1(LI0, LI1, LI2, LI3, SI0, SI1)
  b_nested_1(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_2(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI3 + LO3 = 0 && LO2 = 0
  b_nested_2(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_7(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + SO1 = 0 && -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI2 + SO0 = 0 && -LI2 + LO2 = 0 && -LI3 + LO3 = 0
  b_nested_2(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_3(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + SO1 = 0 && -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI2 + SO0 = 0 && -LI2 + LO2 = 0 && -LI3 + LO3 = 0
  b_nested_3(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_4(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI2 + LO2 = 0 && LO3 = 0 && -SI0 + SI1 - 1 >= 0
  b_nested_4(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_6(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + SO1 = 0 && -LI1 + LO1 = 0 && -LI2 + LO2 = 0 && -LI3 + SO0 = 0 && -LI3 + LO3 = 0
  b_nested_4(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_5(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + SO1 = 0 && -LI1 + LO1 = 0 && -LI2 + LO2 = 0 && -LI3 + SO0 = 0 && -LI3 + LO3 = 0
  b_nested_5(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_4(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI2 + LO2 = 0 && -LI3 + LO3 - 1 = 0 && -SI0 + SI1 - 1 >= 0
  b_nested_6(LI0, LI1, LI2, LI3, SI0, SI1) -> b_nested_2(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI2 + LO2 - 1 = 0 && -LI3 + LO3 = 0 && SI0 - SI1 >= 0
)
