  b_main_exc_3(LI0, LI1, LI2, LI3, SI0, SI1) -> b_main_exc_9(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI2 + SO0 = 0 && -LI2 + LO2 = 0 && -LI3 + LO3 = 0 && SO1 - 20 = 0 && LI1 >= 0 && LI0 >= 0
