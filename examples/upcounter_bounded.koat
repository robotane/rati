(GOAL COMPLEXITY)
(STARTTERM (FUNCTIONSYMBOLS koat_init))
(VAR LI0 LI1 LI2 LI3 SI0 SI1)
(RULES
  koat_init(LI0, LI1, LI2, LI3, SI0, SI1) -> b_main_exc_1(LI0, LI1, LI2, LI3, SI0, SI1)
  b_main_exc_1(LI0, LI1, LI2, LI3, SI0, SI1) -> b_main_exc_2(LO0, LO1, LO2, LO3, SO0, SO1) :|: -LI0 + LO0 = 0 && -LI1 + LO1 = 0 && -LI2 + LO2 = 0 && -LI3 + LO3 = 0 && SO1 - 1 = 0 && SO0 - 1 = 0 && LI0 >= 0
